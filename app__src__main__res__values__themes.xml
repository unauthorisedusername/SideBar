        <!-- Arknights style: deep black base, avoids a white flash at launch -->
        <item name="android:windowBackground">@color/ak_bg</item>
        <item name="android:colorBackground">@color/ak_bg</item>
        <item name="android:statusBarColor">@color/ak_bg</item>
        <item name="android:navigationBarColor">@color/ak_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
